<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <groupId>com.huawei.its</groupId>
    <version>${VERSION}</version>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>${SERVICE_NAME}</artifactId>
    <name>${SERVICE_NAME}</name>

    <properties>
        <base.image>${BASE_IMAGE}</base.image>
        <label.from.list>${LABEL_FROM_LIST}</label.from.list>
        <service.package.name>${SERVICE_NAME}</service.package.name>
        <service.version>${VERSION}</service.version>
        <deploy.source.dir>../Package/images</deploy.source.dir>
        <dockerfile.dockerfile>Dockerfile</dockerfile.dockerfile>
    </properties>


    <packaging>pom</packaging>


    <build>
        <plugins>
             <plugin>
                <groupId>se.vandmo</groupId>
                <artifactId>dependency-lock-maven-plugin</artifactId>
                <version>0.25</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-bin</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <encoding>UTF-8</encoding>
                            <!--要复制到的路径-->
                            <outputDirectory>
                                ${project.build.directory}/${service.package.name}
                            </outputDirectory>
                            <resources>
                                <resource>
                                    <!--项目中文件的路径-->
                                    <directory>../Package/images</directory>
                                    <filtering>false</filtering>
                                    <excludes>
                                        <exclude>Dockerfile*</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                    <!--todo 修改copy operator-->
                    <execution>
                        <id>copy-Dockerfile</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <encoding>UTF-8</encoding>
                            <!--要复制到的路径-->
                            <outputDirectory>
                                ${project.build.directory}/../
                            </outputDirectory>
                            <resources>
                                <resource>
                                    <!--项目中文件的路径-->
                                    <directory>../Package/images</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>Dockerfile*</include>
                                    </includes>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.spotify</groupId>
                <artifactId>dockerfile-maven-plugin</artifactId>
                <configuration>
                    <skipPush>true</skipPush>
                    <repository>${service.package.name}</repository>
                    <tag>${service.version}</tag>
                    <pullNewerImage>false</pullNewerImage>
                    <skipDockerInfo>true</skipDockerInfo>
                    <dockerfile>${dockerfile.dockerfile}</dockerfile>
                    <buildArgs>
                        <BASE_IMAGE>${base.image}</BASE_IMAGE>
                        <LABEL_FROM_LIST>${label.from.list}</LABEL_FROM_LIST>
                        <SERVICE_NAME>${service.package.name}</SERVICE_NAME>
                    </buildArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>build-docker</id>
                        <goals>
                            <goal>build</goal>
                            <goal>tag</goal>
                        </goals>
                        <phase>install</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.huawei.ryoma.plugins</groupId>
                <artifactId>docker-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-image</id>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <phase>clean</phase>
                        <configuration>
                            <docker>docker</docker>
                            <baseDirectory>${project.basedir}</baseDirectory>
                            <cleanExitedContainer>true</cleanExitedContainer>
                            <cleanDanglingVolume>true</cleanDanglingVolume>
                            <cleanDanglingImage>true</cleanDanglingImage>
                        </configuration>
                    </execution>
                    <execution>
                        <id>slim-image</id>
                        <goals>
                            <goal>slim</goal>
                        </goals>
                        <phase>install</phase>
                        <configuration>
                            <baseImage>${base.image}</baseImage>
                            <serviceImage>${service.package.name}:${service.version}</serviceImage>
                            <clearTempDirectory>false</clearTempDirectory>
                            <docker>docker</docker>
                            <workingDirectory>${project.build.directory}</workingDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
